# Cloudflare Workers static assets — το αρχείο διαβάζεται και δεν σερβίρεται.
# Τα assets έχουν hash στο όνομα (index-Bq8B5T5g.js), άρα ασφαλές immutable cache.
/assets/*
  Cache-Control: public, max-age=31556952, immutable

# Το index.html μένει στο default (max-age=0, must-revalidate) ώστε να μη σερβίρεται παλιό build.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
